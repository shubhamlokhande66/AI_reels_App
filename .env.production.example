# Copy to .env.production on the server and fill in. Never commit the real file.

# Your domain, pointing (DNS A record) at this server. HTTPS is set up automatically.
DOMAIN=reels.example.com

# Accounts: sign-in is required; this key signs the session cookies. Use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Admin key: unlocks AI settings and the diagnostic screens (open https://DOMAIN/admin once and enter it).
ADMIN_KEY=

# AI (Gemini recommended): the key stays on the server, never in the browser.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# How many renders run at once (the rest wait in the queue). 1 for a 4 GB server, 2 for 8 GB, 3-4 for 16 GB+.
MAX_CONCURRENT_JOBS=1

# Uploads
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50

# Reviewer / self-correction
REVIEW_THRESHOLD=70
REVIEW_MAX_ITERATIONS=3

# ---- Live trends (optional): a licensed / official trend-data feed returning JSON presets (docs/deploy.md) ----
TREND_FEED_URL=
TREND_FEED_KEY=

# ---- Publishing (optional): official platform APIs. Empty = "not connected" (users download / share instead) ----
# The public https address of this studio: Instagram and TikTok fetch the video from a signed, short-lived link on it.
PUBLIC_BASE_URL=https://reels.example.com
# Instagram professional account via the Meta Graph API (instagram_content_publish permission)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# TikTok Content Posting API (an approved app; verify PUBLIC_BASE_URL's domain in the TikTok developer portal)
TIKTOK_ACCESS_TOKEN=
# YouTube Data API v3 (OAuth client + a refresh token with the youtube.upload scope)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Database: MongoDB Atlas (the free 512 MB cluster is plenty: only small records are stored, videos stay on disk) ----
# Atlas > Connect > Drivers: copy the connection string; allow this server's IP under Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_reel_maker

# ---- Automatic deletion (the admin can change these on the Admin page; that setting then wins) ----
RETENTION_ENABLED=true
KEEP_UPLOADS_HOURS=2
KEEP_PROJECTS_HOURS=24

# ---- Story -> Reel pictures (cheapest first: shared library, public-domain paintings, free AI, paid AI) ----
# Free AI pictures: a free Cloudflare account > Workers AI (FLUX.1 schnell; a free daily allowance)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Paid AI pictures, only if you want them: "" (off) | gemini | openai  (needs that provider's key with billing)
STORY_PAID_IMAGES=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_IMAGE_MODEL=gpt-image-2
# A contact for Wikimedia's API (their policy asks clients to say who they are); your site address is used too
CONTACT_EMAIL=

# ---- Billing: credits + Razorpay payments (UPI, cards). Use rzp_test_ keys first, then live keys. ----
BILLING_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Webhooks: URL https://YOUR-DOMAIN/api/public/billing/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---- Your business (legal and contact pages; Razorpay checks that these pages exist) ----
BUSINESS_NAME=Reel Maison
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_ADDRESS=
LEGAL_UPDATED=8 October 2026

# ---- Email for password reset: any SMTP service (Gmail app password, Brevo, Zoho, Amazon SES). Empty = link in the log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
