# dependencies
node_modules/
/.pnp
.pnp.*

# Next.js build output
.next/
/out/
/build
/coverage
next-env.d.ts
*.tsbuildinfo

# env files: secrets stay local (the .example file is committed)
.env
.env.*
!.env.example
.dev.vars

# local app data (uploaded songs, saved settings) and personal footage: never in the repository
/storage/
/reels/
# local test songs (copyrighted music, large files)
/songs/

# logs
*.log
*.log.err
npm-debug.log*

# manual test output
tests/server/manual/*.json
tests/server/manual/compare.txt
tests/server/manual/profile.txt
tests/server/manual/out/

# Cloudflare (Wrangler) local state
.wrangler/

# misc
.DS_Store
*.pem
.vercel

# local test songs and reference analyses (copyrighted audio)
/TestFile/

# downloaded ML models (Beat This!, ~190 MB; fetched and checksum-checked on first use)
/models/

# Full-precision Beat This! model (83 MB): only for comparing with the 8-bit one (BEAT_THIS_MODEL=fp32); not shipped
server/audio/data/beat-this/beat_this_final0.onnx

# ONNX Runtime WebAssembly and Piper's phonemizer, copied from node_modules by scripts/copy-ort.mjs
/public/vendor/ort/
/public/vendor/piper/

# Fast Studio test material, generated by the scripts next to it
/scripts/studio-beats/**/*.wav
/scripts/studio-beats/**/truth.json
/scripts/studio-beats/**/beatthis.json
/scripts/studio-beats/set2/
/scripts/studio-beats/set3/
/scripts/studio-beats/deg*/
/scripts/studio-scenes/out/
/scripts/studio-style/out/

# Fast Studio iPhone test media and exports
scripts/studio-iphone/media/
scripts/studio-iphone/export_*
scripts/studio-length/out/
scripts/studio-talk/out/
scripts/studio-vision/out/
scripts/studio-voiceover/out/
scripts/studio-keyframes/out/

# made by scripts/cf-assets.mjs before a Cloudflare deploy
/cloudflare/assets/

# Android upload key (docs/android-release.md)
*.jks
*.keystore
android/keystore.properties
.env*
!.env.example
