// Reel Maker on Cloudflare (Workers + Containers + R2). Deploy: see docs/deploy-cloudflare.md.
// Secrets (never in this file): npx wrangler secret put <NAME>  for MONGODB_URI, SECRET_KEY, ADMIN_KEY,
// R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, OPENAI_API_KEY / GEMINI_API_KEY ... (every secret is passed to the app).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reel-maker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ReelApp",
      "image": "../docker/Dockerfile",
      "image_build_context": "..",
      // 2 vCPU, 8 GB, 16 GB disk: rendering and video analysis. Billed only while the container is awake.
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "ReelApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReelApp"] }],
  "vars": {
    "NODE_ENV": "production",
    "SLEEP_AFTER": "30s", // stops 30 s after the last request (an upload or download in progress counts)
    "STORAGE_PATH": "/data/storage",
    "R2_BUCKET": "smgroup",
    "R2_ACCOUNT_ID": "2d7702f8679dc5b3d44ce59ab951ca00",
    "PUBLIC_BASE_URL": "https://reel-maker.shubhlokhande850.workers.dev",
    "AUTH_ENABLED": "true",
    "COOKIE_SECURE": "true",
    "AI_PROVIDER": "openai",
    "OPENAI_TEXT_MODEL": "gpt-5.6-luna",
    "GEMINI_TEXT_MODEL": "gemini-3.5-flash-lite",
    "MAX_CONCURRENT_JOBS": "1",
    // uploads pass through the Worker, which accepts request bodies up to 100 MB on the Free and Pro plans
    "MAX_VIDEO_SIZE_MB": "95"
  }
}
