# One domain for everything, with automatic HTTPS (Let's Encrypt). DOMAIN comes from .env.production.
{$DOMAIN} {
	encode zstd gzip

	# the app: the website and the API (with media files and uploads) in one Next.js server
	reverse_proxy app:3000 {
		transport http {
			read_timeout 15m   # long uploads
			write_timeout 15m  # large downloads
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
