# One domain for everything, with automatic HTTPS (Let's Encrypt). DOMAIN comes from .env.production.
{$DOMAIN} {
	encode zstd gzip

	# the API (and media files, uploads): the Python backend
	handle /api/* {
		reverse_proxy backend:8000 {
			transport http {
				read_timeout 15m   # long uploads
				write_timeout 15m  # large downloads
			}
		}
	}

	# everything else: the website
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
