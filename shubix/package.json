{
  "name": "shubix",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev:api": "node scripts/with-log.mjs api pnpm --filter @shubix/api dev",
    "dev:web": "node scripts/with-log.mjs web pnpm --filter @shubix/web-app dev",
    "dev:mobile": "node scripts/with-log.mjs mobile pnpm --filter @shubix/mobile-app start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test"
  }
}
