<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 11 and later: without this the app cannot see the phone's text-to-speech (SystemVoice.kt) -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>
</manifest>
