# FE/mobile-app settings (EAS -> Environment variables for builds). No secrets: everything here is built into the app.
# the API (BE/api). Emulator: 10.0.2.2; a physical phone: your LAN IP or an HTTPS host; live: the Cloudflare address
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# the website (FE/web-app): the phone's hidden studio opens /engine there. Live: the Vercel address
EXPO_PUBLIC_SITE_URL=http://localhost:3001
# AdMob app ids (AdMob -> Apps -> App settings), at build time; empty: Google's test ads
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
