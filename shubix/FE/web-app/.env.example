# FE/web-app settings (the website only: no secrets here, they stay with the API). Copy to FE/web-app/.env.local.
# On Vercel: Project -> Settings -> Environment Variables. Read when the website is built: deploy again after a change.
# The API's settings: BE/api/.env.example.

# where /api/* is sent (the API: BE/api). Cloudflare: https://shubix-api.<subdomain>.workers.dev (no / at the end)
API_URL=http://localhost:4000
# the website's own https address (links shared on social sites, page previews)
PUBLIC_BASE_URL=
# optional: the browser calls another API directly instead of /api on this site (leave empty: cookies stay first-party)
NEXT_PUBLIC_API_URL=
