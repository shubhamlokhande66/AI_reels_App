NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/ai_reel_maker
MONGODB_DB=ai_reel_maker

# Storage (local filesystem for development)
STORAGE_PATH=./storage

# ---------------------------------------------------------------- AI
# Provider: ollama | openai | gemini. Also selectable in the app (Settings -> AI provider; a saved choice wins over
# this file). API keys live ONLY here (server side); they are never sent to the browser, logged or returned in errors.
AI_PROVIDER=ollama
# Optional per-kind providers (empty = AI_PROVIDER), e.g. text on openai and vision on gemini
AI_TEXT_PROVIDER=
AI_VISION_PROVIDER=
# Optional fallback, used only for operational failures (timeout, outage, rate limit, quota, bad key), never for
# refusals or invalid requests. Off = never switch providers silently.
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=
# Retries of rate-limit / temporary errors
AI_MAX_RETRIES=2

# Ollama (local: no media leaves the machine)
OLLAMA_BASE_URL=http://localhost:11434
# Any model you have pulled, e.g. the one shown by `ollama list`. Not hard-coded anywhere.
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
# Seconds to wait for one local-model answer (CPU inference can be slow, more so on a cold model load).
AI_TIMEOUT_SECONDS=300

# OpenAI (official SDK, Responses API, schema-constrained structured output)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_BASE_URL=
# Optional for reasoning models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=

# Gemini (official google-genai SDK, JSON-schema structured output)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=

# Claude (official anthropic SDK, JSON-schema structured output). Set AI_PROVIDER=claude to use it.
ANTHROPIC_API_KEY=
CLAUDE_TEXT_MODEL=claude-opus-5-5
CLAUDE_VISION_MODEL=
# How deeply Claude thinks: low | medium | high | xhigh | max (higher = better plans, more cost and time)
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_SECONDS=180

# Seconds to wait for one cloud answer (OpenAI / Gemini)
CLOUD_AI_TIMEOUT_SECONDS=60

# Vision: frames sent per clip (distinct, representative keyframes; never whole videos)
VISION_MAX_FRAMES_PER_CLIP=4
VISION_MAX_IMAGE_SIZE=384
VISION_DETAIL_LEVEL=low

# Cost + budget. Prices are yours to set: USD per 1M tokens, longest model-name prefix wins; unpriced = "not priced".
# AI_MODEL_PRICES={"model-name": {"input": 0.40, "output": 1.60, "cached": 0.10}}
AI_MODEL_PRICES=
AI_CURRENCY=USD
AI_CURRENCY_RATE=1
# In AI_CURRENCY; 0 = no limit. When used up, automatic (non-essential) AI stops; rule-based Reels still work.
DAILY_AI_BUDGET=0
MONTHLY_AI_BUDGET=0

# Captions: local Whisper when @huggingface/transformers is installed (npm install @huggingface/transformers),
# else the OpenAI API when OPENAI_API_KEY is set. The local model downloads on first use.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=

# Limits
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=50
MAX_VIDEOS_PER_PROJECT=0  # 0 = unlimited
# Direct uploads: with the R2 settings (R2_ACCOUNT_ID, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY), clips go from
# the browser straight into R2 in parallel parts (docs/deploy-cloudflare.md: the bucket needs a CORS rule). off = always
# through this server.
DIRECT_UPLOADS=on
MAX_DIRECT_VIDEO_SIZE_MB=4096
# With a mounted bucket: local copies of clips and songs kept on the container's disk for analysis and renders
MEDIA_CACHE_GB=10
RENDER_TIMEOUT_SECONDS=900
# Shots cut at the same time (2 keeps two cores busy); slowed-down shots: blend (fast) | mci (motion estimation, ~1 min per shot)
RENDER_PARALLEL=2
SLOWMO_SMOOTHING=blend
MAX_CONCURRENT_JOBS=1
# The job queue is in MongoDB: every instance that runs jobs takes waiting ones (oldest first) and requeues stalled ones.
# APP_ROLE: all (answer requests and run jobs) | web (requests only) | worker (jobs only, for extra render machines)
APP_ROLE=all
JOB_POLL_SECONDS=5
RATE_LIMIT_PER_MINUTE=60

# Output format (Instagram Reels / Shorts / TikTok)
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# Optional FFmpeg overrides (auto-detected from PATH when empty)
FFMPEG_BIN=
FFPROBE_BIN=

# ---------------------------------------------------------------- Songs
# Folders whose audio files are added to the song library automatically (";"-separated), e.g. C:\Users\you\Downloads
SONG_IMPORT_FOLDERS=
# (kept on the server; previews and downloads are proxied, and only tracks the artist allows to download are added)

# ---- Production
# Administrators: the accounts (comma-separated emails) that open the admin dashboard (/admin), each with a code emailed
# to it once a day. More can be added in Admin → Settings → Administrators. With accounts on and this empty, nobody is
# admin; with accounts off (one person, on one computer) that person is.
ADMIN_EMAILS=
# Reviewer: below this score a final Reel is corrected and rendered again (at most REVIEW_MAX_ITERATIONS reviews).
REVIEW_THRESHOLD=70
REVIEW_MAX_ITERATIONS=3

# ---- Live trends (optional): a licensed / official trend-data feed returning JSON presets (docs/deploy.md) ----
TREND_FEED_URL=
TREND_FEED_KEY=

# ---- Publishing (optional): official platform APIs. Empty = "not connected" (users download / share instead) ----
# The public https address of this studio: Instagram and TikTok fetch the video from a signed, short-lived link on it.
PUBLIC_BASE_URL=
# Instagram professional account via the Meta Graph API (instagram_content_publish permission)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# TikTok Content Posting API (an approved app; verify PUBLIC_BASE_URL's domain in the TikTok developer portal)
TIKTOK_ACCESS_TOKEN=
# YouTube Data API v3 (OAuth client + a refresh token with the youtube.upload scope)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Accounts (production): sign-in required, each user's data private ----
AUTH_ENABLED=false
SECRET_KEY=
COOKIE_SECURE=false

# ---- Automatic deletion (admin can change it on the Admin page) ----
RETENTION_ENABLED=false
KEEP_UPLOADS_HOURS=2
KEEP_PROJECTS_HOURS=24

# ---- Story -> Reel pictures (cheapest first: shared library, public-domain paintings, free AI, paid AI) ----
# Free AI pictures: a free Cloudflare account > Workers AI (FLUX.1 schnell; a free daily allowance)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Paid AI pictures, only if you want them: "" (off) | gemini | openai  (needs that provider's key with billing)
STORY_PAID_IMAGES=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_IMAGE_MODEL=gpt-image-2
# A contact for Wikimedia's API (their policy asks clients to say who they are); your site address is used too
CONTACT_EMAIL=

# ---- Billing: credits + Razorpay (off locally; needs AUTH_ENABLED=true as well) ----
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Your business (legal and contact pages; Razorpay checks that these pages exist) ----
BUSINESS_NAME=Shubix
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_ADDRESS=
LEGAL_UPDATED=8 October 2026

# ---- Email for password reset: any SMTP service (Gmail app password, Brevo, Zoho, Amazon SES). Empty = link in the log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
# A second email service, used when the first fails (its daily limit, an outage). E.g. Gmail above (App password) and
# Brevo here (smtp-relay.brevo.com, the SMTP key from Brevo → SMTP & API). `node scripts/smtp-check.mjs` checks both.
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM=
SMTP_FALLBACK_SSL=false
# Optional: a scheduler's key for POST /api/cron/reminders (header x-cron-secret). Empty: the unfinished-checkout
# reminders still go out as people use the site.
CRON_SECRET=

# OpenAI voices (narration): gpt-4o-mini-tts follows a speaking style; tts-1 is cheaper
OPENAI_TTS_MODEL=gpt-4o-mini-tts
